# Database Configuration (Laragon / MySQL defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=laundrigo_db

# Server Configuration
PORT=5000
JWT_SECRET=laundrigo_super_secret_jwt_key_2026_lagonglong
FRONTEND_URL=http://localhost:5173

# SMS Notification Gateway for Driver Approval
# Option 1: Semaphore (Recommended for Philippines - https://semaphore.co)
# Obtain your API key from your Semaphore dashboard
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=SEMAPHORE

# Option 2: Twilio (Global alternative SMS provider - https://twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Google OAuth Configuration
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Philippine Payment Gateway (PayMongo for GCash)
# Optional: If left blank, LaundriGo operates with a built-in sandbox GCash gateway simulator
PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Email Delivery Configuration (Optional for Password Reset)
# If not configured, password reset links are automatically logged to the terminal console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="LaundriGo Support" <noreply@laundrigo.ph>
